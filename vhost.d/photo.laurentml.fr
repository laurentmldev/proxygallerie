# Extra directives nginx-proxy injects into the HTTPS server block for
# photo.laurentml.fr specifically (mounted read-only into the
# nginx-proxy container at /etc/nginx/vhost.d/photo.laurentml.fr - see
# docker-compose.yml). Applies only once a certificate exists for this
# host, same as the rest of the HTTPS server block.

# Tells browsers to remember, for a year, to only ever reach this site
# over HTTPS - reinforces "HTTPS only" beyond just redirecting HTTP.
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

# "Site en maintenance" page when the backend isn't answering
# (see maintenance/maintenance.conf).
include /etc/nginx/snippets/maintenance.conf;

# Largest request accepted (nginx's default is 1 MB). The site's admin
# mode uploads photos one per request, up to ADMIN_MAX_UPLOAD_MB (50 MB
# by default) each, so allow a little more than that.
client_max_body_size 60m;
