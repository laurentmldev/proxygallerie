# Copy to ".env" next to docker-compose.yml.

# Email Let's Encrypt will use for certificate-expiry warnings if
# automatic renewal ever fails. Required.
LETSENCRYPT_EMAIL=you@example.com

# Root domain that serves the gallery of all sites behind the proxy.
# Its DNS A/AAAA record must point at this server.
ROOT_DOMAIN=laurentml.fr

# Heading and optional tagline shown on the gallery page.
GALLERY_PAGE_TITLE=laurentml.fr
GALLERY_PAGE_SUBTITLE=
